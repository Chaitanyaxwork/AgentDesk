# Supabase project credentials. Secret keys must remain server-side.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key
# Legacy compatibility only; prefer the current publishable/secret keys above.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini API. Never add a billing account while zero-spend mode is enabled.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_GENERATION_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_REQUEST_TIMEOUT_MS=12000
AI_DIAGNOSTICS_ENABLED=false

# Zero-spend kill switches. AI stays disabled unless each operator acknowledgement is explicit.
AI_ENABLED=false
FREE_TIER_MODE=true
ALLOW_PAID_AI=false
GEMINI_BILLING_DISABLED=false
GEMINI_UNPAID_DATA_APPROVED=false

# Region and abuse controls. Configure a platform-injected header only after verifying your host.
AI_GEO_PROVIDER=
AI_TRUSTED_GEO_HEADER_CONFIRMED=false
AI_USAGE_HASH_SECRET=replace_with_at_least_32_random_characters
AI_GLOBAL_DAILY_MAX_REQUESTS=100
AI_WORKSPACE_MONTHLY_MAX_REPLIES=10000
AI_IP_MAX_REQUESTS_PER_MINUTE=10
AI_INGEST_IP_MAX_REQUESTS_PER_MINUTE=60

# Optional price localization. Use only a provider header confirmed to be overwritten by your host.
PRICING_GEO_PROVIDER=
PRICING_TRUSTED_GEO_HEADER_CONFIRMED=false

# Hard-capped processing limits. Source pages are capped at 5 in code.
MAX_AI_REPLY_TOKENS=256
MAX_MESSAGE_CHARS=2000
MAX_SOURCE_PAGES=5
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.45

# Live RAG evaluation is opt-in and writes temporary synthetic staging data.
# Never set these values for a production Supabase project.
AGENTDESK_LIVE_EVAL_STAGING_ACK=
AGENTDESK_LIVE_EVAL_BUSINESS_ID=
AGENTDESK_LIVE_EVAL_OTHER_BUSINESS_ID=
AGENTDESK_LIVE_EVAL_COUNTRY=US

# Razorpay recurring billing. All disabled until test credentials and account approval exist.
RAZORPAY_MODE=test
RAZORPAY_ENABLED=false
RAZORPAY_CHECKOUT_ENABLED=false
RAZORPAY_LIVE_MODE_APPROVED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
